<?xml version="1.0"?>
<sdf version="1.6">
  <world name="three_lane_formation">
    <include><uri>model://ground_plane</uri></include>
    <include><uri>model://sun</uri></include>
    <gravity>0 0 -9.8</gravity>
    <physics name="default_physics" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>

    <model name="wall_west">
      <static>true</static><pose>-3.15 0 0.2 0 0 0</pose>
      <link name="link"><collision name="collision"><geometry><box><size>0.1 3.2 0.4</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.1 3.2 0.4</size></box></geometry><material><ambient>0.25 0.25 0.3 1</ambient><diffuse>0.25 0.25 0.3 1</diffuse></material></visual></link>
    </model>
    <model name="wall_east">
      <static>true</static><pose>3.15 0 0.2 0 0 0</pose>
      <link name="link"><collision name="collision"><geometry><box><size>0.1 3.2 0.4</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.1 3.2 0.4</size></box></geometry><material><ambient>0.25 0.25 0.3 1</ambient><diffuse>0.25 0.25 0.3 1</diffuse></material></visual></link>
    </model>
    <model name="wall_south">
      <static>true</static><pose>0 -1.55 0.2 0 0 0</pose>
      <link name="link"><collision name="collision"><geometry><box><size>6.2 0.1 0.4</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>6.2 0.1 0.4</size></box></geometry><material><ambient>0.25 0.25 0.3 1</ambient><diffuse>0.25 0.25 0.3 1</diffuse></material></visual></link>
    </model>
    <model name="wall_north">
      <static>true</static><pose>0 1.55 0.2 0 0 0</pose>
      <link name="link"><collision name="collision"><geometry><box><size>6.2 0.1 0.4</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>6.2 0.1 0.4</size></box></geometry><material><ambient>0.25 0.25 0.3 1</ambient><diffuse>0.25 0.25 0.3 1</diffuse></material></visual></link>
    </model>
  </world>
</sdf>
