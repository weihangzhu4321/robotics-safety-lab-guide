# 到场复制为 现场参数.env，逐项替换 CHANGE_ME，不写密码。
# 仅填写本组独立实验网络中的三端。
IFACE=CHANGE_ME
CTRL_IP=CHANGE_ME
CTRL_MAC=CHANGE_ME
ROBOT_IP=CHANGE_ME
ROBOT_MAC=CHANGE_ME
ATTACKER_MAC=CHANGE_ME
# 以下在控制机A本地抓包时使用。
A_IFACE=CHANGE_ME
# 以下是现存 /cmd_vel TCPROS 的数据方向 A -> B；不是固定ROS端口。
# 完成握手/节点/消息类型核对之后才填写。重启teleop后须重新确认。
PUB_PORT=CHANGE_ME
SUB_PORT=CHANGE_ME
